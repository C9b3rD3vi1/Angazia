# Server Configuration
PORT=3000
ENVIRONMENT=development
APP_NAME=Angazia
APP_VERSION=1.0.0
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=angazia_db
DB_SSL_MODE=disable

# JWT Configuration
JWT_SECRET=your-super-secret-key-change-this-in-production
JWT_EXPIRY_HOURS=24

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URL=http://localhost:3000/api/v1/github/callback
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# OpenAI API
OPENAI_API_KEY=your_openai_api_key

# SMTP Configuration (Email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@angazia.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_NAME=Angazia
SMTP_FROM_EMAIL=noreply@angazia.com

# IntaSend Payment Gateway (get keys from https://sandbox.intasend.com)
INTASEND_API_KEY=your_intasend_api_key
INTASEND_API_SECRET=your_intasend_api_secret
INTASEND_PUBLISHABLE_KEY=your_intasend_publishable_key
INTASEND_BASE_URL= # optional, defaults to https://sandbox.intasend.com (dev) or https://api.intasend.com (prod)

# M-Pesa (Future)
MPESA_CONSUMER_KEY=your_mpesa_consumer_key
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_mpesa_passkey
MPESA_ENVIRONMENT=sandbox

# Redis (For caching and sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0


# Email Provider (sendgrid, resend, smtp)
EMAIL_PROVIDER=smtp

# SendGrid (if using SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key

# Resend (if using Resend)
RESEND_API_KEY=your_resend_api_key


# Security
REQUIRE_EMAIL_VERIFICATION=true

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_DURATION=60

# File Upload
MAX_FILE_SIZE=10485760 # 10MB
ALLOWED_FILE_TYPES=.pdf,.doc,.docx,.txt

# Application Settings
PAGE_SIZE=20
MAX_JOB_POSTS_FREE=3
MAX_JOB_POSTS_PRO=20
MAX_JOB_POSTS_ENTERPRISE=100

# AI Configuration
AI_PROVIDER=openai                    # openai, anthropic, gemini, local
AI_MODEL=gpt-4-turbo-preview

# OpenAI
OPENAI_API_KEY=your_openai_api_key

# Anthropic (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Google Gemini (optional)
GEMINI_API_KEY=your_gemini_api_key

# Local LLM (optional)
LOCAL_LLM_URL=http://localhost:8080/v1/completions